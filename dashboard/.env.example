# MCP Server Builder dashboard settings.
# Copy to dashboard/.env for local use. In Azure, set these as App Service
# application settings (secrets as Key Vault references). Never commit real values.
# The server refuses to start if a required value is missing or unsafe.

# Public address people open in the browser. Must be https:// in production.
PUBLIC_URL=https://mcp-builder.example.com

# Microsoft Entra ID (Azure AD) app registration.
# Issuer for a single tenant: https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_ISSUER=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0
OIDC_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Client secret from Certificates & secrets. Store it in Key Vault.
OIDC_CLIENT_SECRET=

# 32 random bytes, base64. Encrypts every saved manifest. Create with:
#   openssl rand -base64 32
# Store it in Key Vault. Losing it means saved manifests cannot be read.
DATA_ENCRYPTION_KEY=

# PostgreSQL (Azure Database for PostgreSQL flexible server). Store it in Key Vault.
# Do not add ?sslmode=...: TLS with certificate checks is always on and the
# server refuses a URL that tries to change it.
DATABASE_URL=postgres://mcpbuilder:<password>@<server>.postgres.database.azure.com:5432/mcpbuilder

# Entra object ids (GUIDs) of the dashboard admins, comma separated.
# Entra admin center > Users > (person) > Object ID.
ADMIN_OIDS=

# Optional
# PORT=8080                      # App Service sets this for you
# HOST=0.0.0.0
# TRUST_PROXY=1                  # set to 1 on App Service (TLS ends at Azure's front end)
# SESSION_IDLE_MINUTES=60        # 5 to 1440
# SESSION_MAX_HOURS=8            # 1 to 168

# Local development only (http on localhost). Never set in production.
# DASHBOARD_INSECURE_DEV=1
# DATABASE_SSL=off   # only for a local database, and only with DASHBOARD_INSECURE_DEV=1
