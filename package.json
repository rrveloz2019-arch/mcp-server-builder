{
  "name": "mcp-server-builder",
  "version": "0.4.0",
  "description": "Generate an MCP server that exposes a company's product and sales API to AI assistants.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "generator",
    "api"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rrveloz2019-arch/mcp-server-builder.git"
  },
  "homepage": "https://github.com/rrveloz2019-arch/mcp-server-builder#readme",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "bin": {
    "mcp-builder": "src/cli/mcp-builder.mjs"
  },
  "files": [
    "src/",
    "scripts/validate-manifest.mjs",
    "schema/",
    "templates/",
    "examples/acme-outdoor.yaml",
    "examples/acme-outdoor-azure.yaml",
    "examples/docs/",
    "examples/mock-api/",
    "docs/"
  ],
  "scripts": {
    "validate": "node scripts/validate-manifest.mjs",
    "generate": "node src/cli/mcp-builder.mjs generate",
    "check-version": "node src/cli/mcp-builder.mjs check-version",
    "mock-api": "node src/cli/mcp-builder.mjs mock-api",
    "test": "node --test scripts/*.test.mjs test/*.test.mjs",
    "azure": "node examples/azure/azure-demo.mjs",
    "intake": "node src/cli/mcp-builder.mjs intake"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@types/node": "^22.20.4",
    "jose": "^6.2.12",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  }
}
